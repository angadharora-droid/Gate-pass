# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically on first run)
MONGODB_DB=gatepass

# Long random string used to sign session tokens — REQUIRED in production
JWT_SECRET=change-me-to-a-long-random-string

# Allowed browser origin(s) for the deployed frontend, comma-separated.
# localhost is always allowed for dev.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional — Railway injects this automatically
PORT=4000
